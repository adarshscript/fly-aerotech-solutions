# MongoDB Atlas connection string (replace with your cluster URI).
# Copy this file to .env.local and fill in the real credentials locally.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fly-aerotech?retryWrites=true&w=majority

# Admin authentication
# Random 32+ char string used to sign JWT session tokens (run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
# Credentials for the seeded super admin account (used by /api/seed)
ADMIN_EMAIL=admin@flyaerotechsolutions.com
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
