# MongoDB Atlas connection string (replace with your cluster URI).
# Copy this file to .env.local and fill in the real credentials locally.
# On Vercel, add these same variables under Project Settings > Environment Variables
# for the Production environment (not only Preview/Development).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fly-aerotech?retryWrites=true&w=majority

# MongoDB database name. Optional; defaults to "fly_aerotech" when unset.
DB_NAME=fly_aerotech

# Admin authentication
# Random 32+ char string used to sign JWT session tokens (run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
# Optional legacy fallback secret (only used if AUTH_SECRET is unset).
JWT_SECRET=

# Public site URL used to build QR "verify" links on certificates.
# Required on Vercel so QR codes point at the real domain (e.g. https://fly-aerotech-solutions.vercel.app).
NEXT_PUBLIC_SITE_URL=https://fly-aerotech-solutions.vercel.app
# Optional legacy fallback used only when NEXT_PUBLIC_SITE_URL is unset.
NEXTAUTH_URL=
# Not used by this codebase (NextAuth is not installed). Harmless if left unset.
NEXTAUTH_SECRET=

# Credentials for the seeded super admin account (used by /api/seed).
# NOTE: /api/seed is disabled in production; the admin account must be created
# locally (or via a one-off script) before deploying, or ADMIN_* vars are unnecessary.
ADMIN_EMAIL=admin@flyaerotechsolutions.com
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
